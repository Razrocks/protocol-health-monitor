FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY api/ ./api/
COPY ingest/ ./ingest/
COPY config/ ./config/
COPY risk/ ./risk/
COPY tools/ ./tools/
COPY db/ ./db/

# Set Python path
ENV PYTHONPATH=/app

WORKDIR /app/api

CMD ["python", "app.py"]